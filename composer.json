{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "chrisjohnleah/bigchange-api-laravel",
    "description": "Laravel bridge for the BigChange REST API SDK.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "chrisjohnleah/bigchange-api": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ChrisJohnLeah\\BigChangeLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisJohnLeah\\BigChangeLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChrisJohnLeah\\BigChangeLaravel\\BigChangeServiceProvider"
            ],
            "aliases": {
                "BigChange": "ChrisJohnLeah\\BigChangeLaravel\\Facades\\BigChange"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
