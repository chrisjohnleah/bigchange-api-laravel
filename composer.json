{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "chrisjohnleah/bigchange-api-laravel",
    "description": "Laravel bridge for the BigChange REST and optional JobWatch SDK.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/chrisjohnleah/bigchange-api-laravel",
    "keywords": ["bigchange", "jobwatch", "api", "sdk", "laravel", "saloon"],
    "support": {
        "issues": "https://github.com/chrisjohnleah/bigchange-api-laravel/issues",
        "source": "https://github.com/chrisjohnleah/bigchange-api-laravel"
    },
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "chrisjohnleah/bigchange-api": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ChrisJohnLeah\\BigChangeLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisJohnLeah\\BigChangeLaravel\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/chrisjohnleah/bigchange-api"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "ChrisJohnLeah\\BigChangeLaravel\\BigChangeServiceProvider"
            ],
            "aliases": {
                "BigChange": "ChrisJohnLeah\\BigChangeLaravel\\Facades\\BigChange"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
